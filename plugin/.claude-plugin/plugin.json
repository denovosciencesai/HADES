{
  "name": "hades",
  "displayName": "HADES drug-likeness score",
  "version": "0.9.1",
  "description": "Score the oral drug-likeness of small molecules from SMILES with HADES (Holistic AI-based Drug-likeness Estimation Score), a soft-voting ensemble over Mordred, ADMET-AI and QED descriptors, served as a local MCP tool. Needs uv on PATH, and the one-time warm-up run in the README: the first install downloads about 3 GB.",
  "author": {
    "name": "Denovo Sciences",
    "url": "https://denovosciences.ai"
  },
  "homepage": "https://github.com/denovosciencesai/HADES",
  "repository": "https://github.com/denovosciencesai/HADES",
  "license": "MIT",
  "keywords": [
    "drug-likeness",
    "drug-discovery",
    "cheminformatics",
    "medicinal-chemistry",
    "smiles",
    "rdkit",
    "admet",
    "qed",
    "mordred",
    "mcp"
  ],
  "mcpServers": {
    "hades": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.10",
        "--from",
        "hades-druglikeness[mcp]==0.9.1",
        "hades-mcp"
      ],
      "env": {
        "UV_EXTRA_INDEX_URL": "https://download.pytorch.org/whl/cpu",
        "UV_INDEX_STRATEGY": "unsafe-best-match"
      }
    }
  }
}
